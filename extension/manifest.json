{
  "manifest_version": 3,
  "name": "Polycast — Video Subtitle Word Saver",
  "version": "1.4.0",
  "description": "Recognize saved words on target-language websites and click words in pages or video subtitles to use your Polycast dictionary.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage", "contextMenus", "activeTab", "scripting"],
  "host_permissions": [
    "http://*/*",
    "https://*/*",
    "*://*.youtube.com/*",
    "https://*.netflix.com/*",
    "http://localhost:5173/*",
    "http://127.0.0.1:5173/*",
    "http://localhost:3000/*",
    "http://127.0.0.1:3000/*",
    "http://localhost:3001/*",
    "https://polycast-sequel.onrender.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["shared/textTokens.js", "shared/wordPopupCore.js", "content/shared.js", "content/youtube.js", "content/selection.js"],
      "css": ["shared/wordPopup.css", "overlay.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://*.netflix.com/*"],
      "js": ["shared/textTokens.js", "shared/wordPopupCore.js", "content/shared.js", "content/netflix.js", "content/selection.js"],
      "css": ["shared/wordPopup.css", "overlay.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "exclude_matches": [
        "*://*.youtube.com/*",
        "https://*.netflix.com/*",
        "https://polycast-sequel.onrender.com/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": ["shared/textTokens.js", "shared/wordPopupCore.js", "content/shared.js", "content/pageHighlights.js", "content/selection.js"],
      "css": ["shared/wordPopup.css", "overlay.css", "content/pageHighlights.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["content/youtube-page.js"],
      "matches": ["*://*.youtube.com/*"]
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
