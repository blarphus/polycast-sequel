{
  "name": "polycast-sequel-server",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.12"
  },
  "type": "module",
  "scripts": {
    "start": "node index.js",
    "dev": "NODE_ENV=development node --watch index.js",
    "test": "NODE_ENV=test JWT_SECRET=polycast-test-secret node --test test/*.test.js lib/*.test.js services/*.test.js",
    "test:integration": "NODE_ENV=test JWT_SECRET=polycast-test-secret node --test test/*.integration.test.js",
    "test:migrations": "NODE_ENV=test JWT_SECRET=polycast-test-secret node scripts/migrationSmoke.js",
    "test:catalog-backfill": "NODE_ENV=test JWT_SECRET=polycast-test-secret node scripts/catalogBackfillSmoke.js",
    "benchmark:startup": "NODE_ENV=test JWT_SECRET=polycast-test-secret node scripts/startupBenchmark.js",
    "catalog:build": "node scripts/buildFrequencyCatalog.js",
    "languages:purge-unsupported": "node scripts/purgeUnsupportedLanguages.js",
    "check": "npm test && npm audit"
  },
  "dependencies": {
    "@extractus/article-extractor": "^9.0.1",
    "@jirimracek/conjugate-esp": "^2.3.6",
    "bcrypt": "^6.0.0",
    "cookie": "^2.0.1",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "fast-xml-parser": "^5.11.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.3.0",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "redis": "^6.2.1",
    "socket.io": "^4.8.0",
    "ws": "^8.21.3",
    "youtube-transcript-plus": "^2.0.1",
    "zod": "^4.5.4"
  }
}
